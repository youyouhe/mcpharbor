{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-cron",
  "version": "0.1.0",
  "description": "OpenCode scheduled task plugin: run prompts in fresh sessions on a cron schedule",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.2",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.13.1"
}
